# Copy this file to .env for local testing (never commit the real .env)
# In GitHub Actions, these are set as repo Secrets instead — see README.

DEEPSEEK_KEY=your_deepseek_api_key
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL=@your_english_channel_username_or_chat_id

# Optional second channel: the same bot mirrors every post here with Farsi
# captions. Leave unset to publish to the English channel only.
TELEGRAM_CHANNEL_FA=@your_farsi_channel_username_or_chat_id

# Optional free data integration
COINGECKO_API_KEY=your_free_demo_key
